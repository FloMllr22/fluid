# Copy to tv.env (git-ignored) and fill in. Read by `npm run deploy` (scripts/deploy.mjs).
# Values set in the environment take precedence over this file.

# IP address or host name of the TV (an alias from ~/.ssh/config works too)
TV_HOST=192.0.2.10
# Port of the Homebrew Channel's SSH server
TV_PORT=22
# User on the TV: root on a rooted TV
TV_USER=root
# Private key for that user; ~ is your home folder. Leave empty to let ssh pick its default keys.
TV_KEY=~/.ssh/fluid_tv
