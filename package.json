{
	"name": "fluid",
	"version": "0.1.0",
	"private": true,
	"description": "Home-screen launcher for rooted LG webOS TVs (webOS 4 / Chromium 53 and later)",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc --noEmit && vite build && node scripts/check-bundle.mjs",
		"lint": "biome check .",
		"format": "biome check --write .",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"check": "npm run lint && npm run typecheck && npm run test",
		"package": "node scripts/package.mjs",
		"install:tv": "node scripts/deploy.mjs",
		"deploy": "npm run build && npm run package && npm run install:tv",
		"manifest": "node scripts/gen-manifest.mjs"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.3",
		"@preact/preset-vite": "^2.10.6",
		"@webos-tools/cli": "^3.2.6",
		"acorn": "^8.19.0",
		"typescript": "^7.0.2",
		"vite": "^5.4.21",
		"vitest": "^3.2.7"
	},
	"dependencies": {
		"preact": "^10.29.8"
	},
	"license": "MIT"
}
