{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		// Markdown is written by hand (aligned tables would turn every one-row change into a
		// whole-table diff).
		"includes": ["**", "!**/*.md", "!package-lock.json"]
	},
	"formatter": {
		"indentStyle": "tab",
		"lineWidth": 120,
		"lineEnding": "lf"
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "single",
			"jsxQuoteStyle": "double",
			"bracketSpacing": false,
			"trailingCommas": "none",
			"semicolons": "always",
			"arrowParentheses": "always"
		}
	},
	"linter": {
		"rules": {
			"preset": "recommended",
			"a11y": {
				// Focus is app state moved by the remote's D-pad, not DOM focus, and the Magic
				// Remote pointer works through mouseenter/click. These rules assume a keyboard-
				// driven web page and don't fit a TV launcher.
				"noStaticElementInteractions": "off",
				"useKeyWithClickEvents": "off",
				"useFocusableInteractive": "off"
			},
			// These rules (and their automatic fixes) rewrite code to APIs that Chromium 53
			// lacks: Object.hasOwn (Chromium 93) and Array.prototype.flatMap (Chromium 69).
			"suspicious": {
				"noPrototypeBuiltins": "off"
			},
			"complexity": {
				"useFlatMap": "off"
			},
			"style": {
				// Browser APIs Chromium 53 (webOS 4) lacks. TypeScript can't catch these because
				// the DOM types always describe the newest browsers. Newer ECMAScript APIs
				// (Object.fromEntries, Array.prototype.flat …) are caught by `lib` in tsconfig.json.
				"noRestrictedGlobals": {
					"level": "error",
					"options": {
						"deniedGlobals": {
							"ResizeObserver": "Not in Chromium 53 (webOS 4). Measure on demand or add a fallback.",
							"structuredClone": "Not in Chromium 53 (webOS 4). Copy explicitly instead."
						}
					}
				}
			}
		}
	},
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	}
}
